":["84dcf7bdfe554a7aeda10ace6ff391860e5a1175","1b25cab007f571b1a4c57e73c17bc40c0db83f25","d5195d73e9ad51b093ed23ae2d8543a90fb3aec2","3f4638b1b9344affb02f9ab3f8281e8aaf6472a9"],"fa":"سلام به همه، این اولین پستم در HW مربوط به FLs است. لطفاً بررسی کنید و نظر بدهید.\n\nممنون.","ib":{"84dcf7bdfe554a7aeda10ace6ff391860e5a1175":2,"1b25cab007f571b1a4c57e73c17bc40c0db83f25":2,"d5195d73e9ad51b093ed23ae2d8543a90fb3aec2":2,"3f4638b1b9344affb02f9ab3f8281e8aaf6472a9":2},"m":703},{"id":"flaglimits_p29_704","t":"Trader slim here is how FLs are drawn.","a":"Aswilled","d":"29 Aug 2014 10:25","r":"Trader","n":"#704","p":29,"im":["d48eafd9889df26bca434aadebdfacdf254ac4ed"],"fa":"معامله‌گر slim، FL‌ها این‌طور کشیده می‌شوند.","ib":{"d48eafd9889df26bca434aadebdfacdf254ac4ed":1},"m":704},{"id":"flaglimits_p29_705","t":"naascott here is how the FLs are drawn","a":"Aswilled","d":"29 Aug 2014 10:40","r":"Trader","n":"#705","p":29,"im":["d6da1feb0475a200aec242103202dddd01ae438f"],"fa":"naascott، FL‌ها این‌طور کشیده می‌شوند","ib":{"d6da1feb0475a200aec242103202dddd01ae438f":1},"m":705},{"id":"flaglimits_p29_706","t":"My first one. No reaction yet","a":"greywind5","d":"29 Aug 2014 15:46","r":"Trader","n":"#706","p":29,"im":["f1048dc1b7ca6d08bccba1057651c5c74646fbc0"],"fa":"اولین مورد من. هنوز واکنشی نبوده","ib":{"f1048dc1b7ca6d08bccba1057651c5c74646fbc0":1},"m":706},{"id":"flaglimits_p29_707","t":"","a":"greywind5","d":"31 Aug 2014 07:13","r":"Trader","n":"#707","p":29,"im":["c6696996e1ea3209510d5e0b4562a557fbe4ff7b","f4f71f6bcf22b668d35411657e1a84fa845c51a4","88c8f3a28e83879772408de0f9854eb87a7ce63e","48b75901d4a38c7c661b3c2dc9583d38d8508b13"],"ib":{"c6696996e1ea3209510d5e0b4562a557fbe4ff7b":0,"f4f71f6bcf22b668d35411657e1a84fa845c51a4":0,"88c8f3a28e83879772408de0f9854eb87a7ce63e":0,"48b75901d4a38c7c661b3c2dc9583d38d8508b13":0},"m":707},{"id":"flaglimits_p29_708","t":"","a":"Aswilled","d":"31 Aug 2014 12:05","r":"Trader","n":"#708","p":29,"im":["74853ade031248374857d2fca43655c0dad4ee44"],"ib":{"74853ade031248374857d2fca43655c0dad4ee44":0},"m":708},{"id":"flaglimits_p29_709","t":"Nice! Thanks","a":"greywind5","d":"31 Aug 2014 12:38","r":"Trader","n":"#709","p":29,"im":[],"fa":"قشنگ بود! ممنون","m":709},{"id":"flaglimits_p29_710","t":"","a":"Aswilled","d":"31 Aug 2014 13:35","r":"Trader","n":"#710","p":29,"im":["1fb950b19c0ada7570c8343321dbbebf54d098f3"],"ib":{"1fb950b19c0ada7570c8343321dbbebf54d098f3":0},"m":710},{"id":"flaglimits_p29_711","t":"Oh, yes. The FL is what you marked, indeed. The black square is the flag itself as drawn by IF in the OP","a":"greywind5","d":"31 Aug 2014 14:30","r":"Trader","n":"#711","p":29,"im":[],"fa":"آه، بله. FL همان چیزی است که علامت زدی، دقیقاً. مربع سیاه خود فلگ است که IF در پست اول کشیده","m":711},{"id":"flaglimits_p29_712","t":"Big picture, stunning of price has reacted","a":"greywind5","d":"01 Sep 2014 11:13","r":"Trader","n":"#712","p":29,"im":["9e350e954e7d139a3c4977bbeab6f07b38ae4dbb"],"fa":"در تصویر بزرگ، واکنش قیمت حیرت‌انگیز است","ib":{"9e350e954e7d139a3c4977bbeab6f07b38ae4dbb":1},"m":712},{"id":"flaglimits_p29_713","t":"","a":"greywind5","d":"02 Sep 2014 07:52","r":"Trader","n":"#713","p":29,"im":["63581c80b7348d45fe6e9266ca9d444d7a86682b","2d09ccd2343256d9a957a8ac0f12a3730e21064c","d646f642f599c694b0a7572eb104438b6e6d6aeb","0af5d2720144fa344dbb289ea13920be1e7c20b7"],"ib":{"63581c80b7348d45fe6e9266ca9d444d7a86682b":0,"2d09ccd2343256d9a957a8ac0f12a3730e21064c":0,"d646f642f599c694b0a7572eb104438b6e6d6aeb":0,"0af5d2720144fa344dbb289ea13920be1e7c20b7":0},"m":713},{"id":"flaglimits_p29_714","t":"","a":"greywind5","d":"02 Sep 2014 18:11","r":"Trader","n":"#714","p":29,"im":["57c03ca55159472cf87f3b60a9b60234988d68e3","8fa1bf1d3373052f2c7f26de700079a9456f9fe7","a4502580386e09906feeb1869330c4b2c2cc0c48"],"ib":{"57c03ca55159472cf87f3b60a9b60234988d68e3":0,"8fa1bf1d3373052f2c7f26de700079a9456f9fe7":0,"a4502580386e09906feeb1869330c4b2c2cc0c48":0},"m":714},{"id":"flaglimits_p29_715","t":"Hi Harry! Can you explain this paragraph with a imaginary chart? Lets look in right order to show you what i understand. a) Hotochin, from the flag i like to trade the FTB to the FL Lets assume that we have a bull flag. After break price make a flag limit. You wait for confirmation on LTF when price return to this FL. The problem is: in LTF our FL its also an entire flag with another FL, in LTF and price goes like that until m1. Can we look at this LTF flag and trade its limits?\n\nb)... and the break of the flag after price returns to it (after it has filled the pole base). This is what i cant understand, Sorry, if i cant explain very clear what i mean, i will make tomorrow youtube video to show you my questions. Thanks, Boby\n\nHarry wrote: Hotochin, from the flag i like to trade the FTB to the FL, and the break of the flag after price returns to it (after it has filled the pole base).\n\nto trade the engulf of the FL would require a few things - that the further FL point is a reaction to something significant. - and also that it gives me a clear place like an FTR or such to base a trade on.\n\npedini and sunny do that a lot in their journals with good success btw, so they are more experienced in this matter. not all structures are good for such a trade but they find good ones and they work for them\n\nbtw, if you have specific example post it and we can discuss it","a":"bobyv87","d":"02 Sep 2014 21:00","r":"Associate Trader","n":"#715","p":29,"im":[],"fa":"سلام Harry! می‌توانی این پاراگراف را با یک چارت فرضی توضیح بدهی؟ بیا به ترتیب درست نگاه کنیم تا نشانت بدهم چه فهمیده‌ام. الف) Hotochin، از روی فلگ دوست دارم FTB تا FL را معامله کنم. فرض کنیم یک فلگ صعودی داریم. بعد از شکست، قیمت یک FL می‌سازد. صبر می‌کنی تا در LTF وقتی قیمت به این FL برمی‌گردد تأیید بگیری. مشکل اینجاست: در LTF، FL ما خودش یک فلگ کامل با یک FL دیگر است، و قیمت همین‌طور پیش می‌رود تا m1. آیا می‌توانیم به این فلگ LTF نگاه کنیم و لیمیت‌هایش را معامله کنیم؟\n\nب)… و شکست فلگ بعد از اینکه قیمت به آن برمی‌گردد (بعد از اینکه پایهٔ دکل را پر کرده). این چیزی است که نمی‌توانم بفهمم. ببخشید اگر نمی‌توانم منظورم را خیلی واضح توضیح بدهم، فردا ویدئوی یوتیوب می‌سازم تا سؤال‌هایم را نشان بدهم. ممنون، Boby\n\nHarry نوشت: Hotochin، از روی فلگ دوست دارم FTB تا FL را معامله کنم، و شکست فلگ بعد از اینکه قیمت به آن برمی‌گردد (بعد از اینکه پایهٔ دکل را پر کرده).\n\nمعاملهٔ اینگالف FL چند چیز لازم دارد — اینکه نقطهٔ FL دورتر واکنشی به چیزی مهم باشد. — و همچنین اینکه جای روشنی مثل FTR یا چیزی شبیه آن به من بدهد تا معامله را بر آن بنا کنم.\n\npedini و sunny در ژورنال‌هایشان این کار را زیاد و با موفقیت خوبی انجام می‌دهند، راستی؛ پس در این موضوع باتجربه‌ترند. همهٔ ساختارها برای چنین معامله‌ای خوب نیستند، اما آن‌ها موارد خوب را پیدا می‌کنند و برایشان جواب می‌دهد\n\nراستی، اگر مثال مشخصی داری پست کن تا درباره‌اش حرف بزنیم","m":715},{"id":"flaglimits_p29_716","t":"Hello All,\n\nHere is my first attempt at the homework for the flag limits. Thanks!","a":"pipscout","d":"03 Sep 2014 05:23","r":"Trader","n":"#716","p":29,"im":["3d2e37e19893f4bda3492a680eb6433d25d8ded8","c94e41a55a8bced8b2945f7e2e08fd073ba731f7","e0096c1c682e0ae5c9f32eae2d3dfcf7311f7e58"],"fa":"سلام به همه،\n\nاین هم اولین تلاش من در HW مربوط به FLs. ممنون!","ib":{"3d2e37e19893f4bda3492a680eb6433d25d8ded8":2,"c94e41a55a8bced8b2945f7e2e08fd073ba731f7":2,"e0096c1c682e0ae5c9f32eae2d3dfcf7311f7e58":2},"m":716},{"id":"flaglimits_p29_717","t":"Hi Pedini! Just a few questions: i made some remarks on FL chart from marketpedia. Let me see if i understand correctly:\n\n1) a PAZ its a space between two FL/FTR(compression is a PAZ, FLAG its a Stacked S/D i dont understand how i can consider a paz ) Now, inside a FLAG (PAZ) we can have another FLAGS with their FLs. Fl itself is a FLAG with its FL. How you look correctly for a range and its FL? For compression its clear but for FLAG not. 2) if price break into a PAZ it want to go to the other side of the PAZ.\n\nFl which define other small flag inside our flag can also act as FTA im alright? How you can see that? There is a video. I think i explained much better there. I hope:D\n\nPedini wrote: Hiya Wes. The circle you have marked is a FL. It tells us that price is happy to range below that level until it breaks. When it breaks, it sends the signal that price will continue higher.\n\nPeds","a":"bobyv87","d":"03 Sep 2014 10:46","r":"Associate Trader","n":"#717","p":29,"im":["4c33327729177bdfabf68e94ca682672851bc33f"],"fa":"سلام Pedini! فقط چند سؤال: روی چارت FL از marketpedia چند نکته نوشتم. بگذار ببینم درست فهمیده‌ام:\n\n1) یک PAZ فضای بین دو FL/FTR است (کامپرشن یک PAZ است، فلگ یک S/D انباشته است؛ نمی‌فهمم چطور می‌توانم یک PAZ را در نظر بگیرم). حالا داخل یک فلگ (PAZ) می‌توانیم فلگ‌های دیگری با FL‌هایشان داشته باشیم. خود FL یک فلگ با FL خودش است. چطور یک رنج و FL آن را درست نگاه می‌کنی؟ برای کامپرشن روشن است اما برای فلگ نه. 2) اگر قیمت به یک PAZ شکست، می‌خواهد به سمت دیگر PAZ برود.\n\nFL‌هایی که فلگ‌های کوچک دیگر داخل فلگ ما را تعریف می‌کنند می‌توانند نقش FTA را هم بازی کنند، درست می‌گویی؟ چطور این را می‌بینی؟ یک ویدئو هست. فکر می‌کنم آنجا خیلی بهتر توضیح داده‌ام. امیدوارم :D\n\nPedini نوشت: سلام Wes. دایره‌ای که علامت زده‌ای یک FL است. به ما می‌گوید قیمت راضی است زیر آن سطح رنج بزند تا وقتی که بشکند. وقتی می‌شکند، این سیگنال را می‌دهد که قیمت بالاتر ادامه می‌دهد.\n\nPeds","ib":{"4c33327729177bdfabf68e94ca682672851bc33f":1},"m":717},{"id":"flaglimits_p29_718","t":"Hello All, Some more FL with follow-on price action. These exercises are helpful and I hope my mind takes them in well. It's a good adjustment.","a":"pipscout","d":"04 Sep 2014 09:56","r":"Trader","n":"#718","p":29,"im":["98e7a7514a37079273cbaec622ee3c6c34c4f748"],"fa":"سلام به همه، چند FL دیگر با PA ادامه‌دار. این تمرین‌ها مفیدند و امیدوارم ذهنم آن‌ها را خوب بگیرد. تنظیم خوبی است.","ib":{"98e7a7514a37079273cbaec622ee3c6c34c4f748":1},"m":718},{"id":"flaglimits_p29_719","t":"","a":"Experiorz","d":"08 Sep 2014 02:36","r":"Trader","n":"#719","p":29,"im":["d5f2d77b8f073d9b487774fd11313fb558322d77"],"ib":{"d5f2d77b8f073d9b487774fd11